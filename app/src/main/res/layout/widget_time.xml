<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget. Only RemoteViews-friendly views are used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_mark"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/widget_ic_shield" />

        <TextView
            android:id="@+id/w_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_label"
            android:textColor="@color/w_text2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/w_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_text3" />

        <ImageView
            android:id="@+id/w_add"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_btn"
            android:contentDescription="@string/widget_add"
            android:scaleType="center"
            android:src="@drawable/widget_ic_plus" />

        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/widget_refresh"
            android:scaleType="center"
            android:src="@drawable/widget_ic_refresh" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">

        <Chronometer
            android:id="@+id/w_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/w_text"
            android:textSize="34sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/w_text"
            android:textSize="34sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/w_text2"
        android:textSize="12.5sp" />

    <FrameLayout
        android:id="@+id/w_bars"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp">

        <ProgressBar android:id="@+id/w_bar_accent" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="1000" android:progressDrawable="@drawable/widget_bar_accent" />
        <ProgressBar android:id="@+id/w_bar_warn" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="1000" android:progressDrawable="@drawable/widget_bar_warn" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_bar_danger" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="1000" android:progressDrawable="@drawable/widget_bar_danger" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_bar_ok" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="1000" android:progressDrawable="@drawable/widget_bar_ok" android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/w_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout android:id="@+id/w_app1" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/w_app1_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_text" android:textSize="13sp" />
            <TextView android:id="@+id/w_app1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="@color/w_text" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/w_app2" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/w_app2_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_text" android:textSize="13sp" />
            <TextView android:id="@+id/w_app2_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="@color/w_text" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/w_app3" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/w_app3_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_text" android:textSize="13sp" />
            <TextView android:id="@+id/w_app3_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="@color/w_text" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/w_app4" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/w_app4_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_text" android:textSize="13sp" />
            <TextView android:id="@+id/w_app4_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="@color/w_text" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
