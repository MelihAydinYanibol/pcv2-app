<?xml version="1.0" encoding="utf-8"?>
<!-- PCV2 servers usually live on the home network (http://192.168.x.y:5035),
     so plain HTTP is allowed. Use HTTPS when the server is on the internet. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
